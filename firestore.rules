rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isContentWriter() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'content_writer'];
    }

    function isCreator() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'content_writer', 'contributor', 'vlogger'];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Articles: public read, limited field updates for auth users, admin-only create/delete
    // Citizen content may be created via moderation (admin) or server
    match /articles/{articleId} {
      allow read: if true;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'likes']);
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // User profiles: owner-only access, cannot self-elevate role
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
              || resource.data.role == request.resource.data.role))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
      allow delete: if false;

      match /history/{historyId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // Public creator profiles
    match /creator_profiles/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'earningsBalance', 'revenueShareEligible']);
      allow delete: if isAdmin();
    }

    // Creator posts (UGC)
    match /creator_posts/{postId} {
      allow read: if resource.data.status == 'published'
        || (request.auth != null && resource.data.authorId == request.auth.uid)
        || isAdmin();
      allow create: if isCreator()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ['draft', 'pending'];
      allow update: if (request.auth != null && resource.data.authorId == request.auth.uid
          && request.resource.data.status in ['draft', 'pending'])
        || isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.authorId == request.auth.uid
            && resource.data.status in ['draft', 'pending']);
    }

    // Role applications
    match /role_applications/{appId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Follow relationships
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
    }

    // Newsletter subscribers — validate email field exists and is a string
    match /subscribers/{subId} {
      allow create: if request.resource.data.keys().hasAll(['email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 255
        && request.resource.data.keys().size() <= 5;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Raw articles (worker pipeline staging area)
    match /raw_articles/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Videos
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News sources registry (worker reads via service account; admin manages)
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings (ads, quality threshold, taxonomy)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sponsored content
    match /sponsors/{sponsorId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // Social media post logs — only content writers+ can create
    match /socialPosts/{postId} {
      allow create: if isContentWriter();
      allow read: if isContentWriter();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
