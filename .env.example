# Firebase (get from Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thebharathnews-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thebharathnews-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thebharathnews-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# Site URL (for canonical links and OG metadata)
NEXT_PUBLIC_SITE_URL=https://thebharathnews.com

# Cloudflare Worker URL (after: npm run worker:deploy)
# Account: bharathnewsweb@gmail.com
NEXT_PUBLIC_WORKER_URL=https://bharathnews-api.bharathnewsweb.workers.dev

# WhatsApp Channel URL
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/YOUR_CHANNEL_ID

# Telegram Channel ID (public, no token)
NEXT_PUBLIC_TELEGRAM_CHANNEL_ID=@YourChannelName

# Google AdSense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=0987654321

# --- SERVER-ONLY (no NEXT_PUBLIC_ prefix) ---
# Cloudflare Worker secrets (workers/secrets.env):
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# RESEND_API_KEY=your_resend_api_key
# TELEGRAM_BOT_TOKEN=your_bot_token
# MAIN_SITE_HOST=thebharathnews.com
# MAIN_SITE_URL=https://thebharathnews.com
