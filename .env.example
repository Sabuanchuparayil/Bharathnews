# Firebase (get from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudflare Worker URL (handles AI, RSS proxy, etc.)
VITE_WORKER_URL=https://bharathnews-api.your-subdomain.workers.dev

# WhatsApp Channel URL
VITE_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/YOUR_CHANNEL_ID

# Telegram Channel ID (public, no token)
VITE_TELEGRAM_CHANNEL_ID=@YourChannelName

# --- SERVER-ONLY (do NOT prefix with VITE_) ---
# These belong in Cloudflare Worker secrets / Firebase Functions env:
# GROQ_API_KEY=your_groq_api_key
# TELEGRAM_BOT_TOKEN=your_bot_token
# MAIN_SITE_HOST=thebharathnews.com
# MAIN_SITE_URL=https://thebharathnews.com
