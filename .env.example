# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Site URL (canonical links and OG metadata — use www; apex redirects to www)
NEXT_PUBLIC_SITE_URL=https://www.thebharathnews.com

# Cloudflare Worker URL (after: npm run worker:deploy)
NEXT_PUBLIC_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Web Push (optional — generate VAPID keys for browser notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# WhatsApp Channel URL
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/YOUR_CHANNEL_ID

# Telegram Channel ID (public handle, not the bot token)
NEXT_PUBLIC_TELEGRAM_CHANNEL_ID=@YourChannelName

# Google AdSense
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=0987654321

# Yandex Metrika (site analytics)
NEXT_PUBLIC_YANDEX_METRIKA_ID=110490900

# --- Google Cloud (optional, alongside Supabase) ---
# GOOGLE_TRANSLATE_API_KEY=                 # Article translation via worker
# YOUTUBE_API_KEY=                          # Optional YouTube Data API (RSS works without it)
# See supabase/README.md → Google OAuth + optional APIs

# IndexNow (optional — Bing/Yandex instant indexing on publish)
# INDEXNOW_KEY=bharathnews2026indexnowkey
# Supabase service role key — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare Worker secrets (copy workers/secrets.env.example → workers/secrets.env):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=<service_role_key>
# WORKER_API_SECRET=openssl_rand_hex_32   # Bearer token for POST /api/* pipeline calls
# ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# RESEND_API_KEY=your_resend_api_key
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHANNEL=@YourChannelName
# TELEGRAM_CHANNEL_ID=@YourChannelName
# MAIN_SITE_HOST=your-domain.com
# MAIN_SITE_URL=https://your-domain.com
