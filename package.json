{
  "name": "the-bharath-news",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint --no-cache",
    "generate-icons": "python3 scripts/generate-brand-icons.py",
    "worker:dev": "npm run dev --prefix workers",
    "worker:deploy": "npm run deploy --prefix workers",
    "worker:secrets": "bash scripts/set-worker-secrets.sh",
    "seed:sources": "node scripts/seed-sources-supabase.mjs",
    "fill:news": "node scripts/fill-news.mjs",
    "fill:news:direct": "node scripts/fill-news-direct.mjs",
    "fix:images": "node scripts/fix-article-images.mjs",
    "remove:janam-tv": "node scripts/remove-janam-tv.mjs",
    "distribute:now": "node scripts/distribute-now.mjs",
    "backfill:distribution": "node scripts/backfill-distribution.mjs",
    "facebook:dlvr-mode": "node scripts/enable-dlvr-facebook.mjs",
    "migrate:distribution": "node scripts/run-migration-distribution.mjs",
    "fetch:videos": "node scripts/fetch-videos-direct.mjs",
    "fill:regional": "node scripts/fill-regional-news.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "setup:google-translate": "node scripts/setup-google-translate.mjs",
