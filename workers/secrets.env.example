# Copy to secrets.env (gitignored) and fill in values, then run:
#   npm run worker:secrets
# Or from repo root: bash scripts/set-worker-secrets.sh

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/your-firebase-adminsdk.json
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL=@YourChannelName
TELEGRAM_CHANNEL_ID=@YourChannelName
ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-haiku-4-5-20251001
RESEND_API_KEY=your_resend_api_key
NEWSLETTER_FROM=Your Site Name <news@your-domain.com>
# Protects POST /api/* manual pipeline triggers (generate: openssl rand -hex 32)
WORKER_API_SECRET=your_random_secret_here
# Optional (Translation uses FIREBASE_SERVICE_ACCOUNT_JSON OAuth if unset):
# GOOGLE_TRANSLATE_API_KEY=your_restricted_api_key
# FACEBOOK_PAGE_ID=
