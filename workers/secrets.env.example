# Copy to secrets.env (gitignored) and fill in values, then run:
#   npm run worker:secrets --prefix ..
# Or from repo root: bash scripts/set-worker-secrets.sh

FIREBASE_PROJECT_ID=thebharathnews-app
FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/thebharathnews-app-firebase-adminsdk.json
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@TheBharathNews
ANTHROPIC_API_KEY=your_anthropic_api_key
# CLAUDE_MODEL=claude-haiku-4-5-20251001
RESEND_API_KEY=your_resend_api_key
NEWSLETTER_FROM=The Bharath News <news@thebharathnews.com>
# Optional:
# FACEBOOK_PAGE_TOKEN=
# FACEBOOK_PAGE_ID=
